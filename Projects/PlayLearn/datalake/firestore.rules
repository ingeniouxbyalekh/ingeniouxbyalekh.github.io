rules_version = '2';

// PlayLearn data lake — Cloud Firestore rules (project: playlearn-cb8c1)
//
// The website only ever APPENDS records. Nobody on the internet can read,
// change or delete them from a browser — read the data from the Firebase
// console or with the Admin SDK (see export_training_data.js), which bypass
// these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function validRecord() {
      let d = request.resource.data;
      return d.keys().hasAll(['schema', 'sessionId', 'visitorId', 'type', 'clientTs'])
        && d.schema is number
        && d.sessionId is string && d.sessionId.size() < 80
        && d.visitorId is string && d.visitorId.size() < 80
        && d.type is string && d.type.size() < 40
        && d.clientTs is number
        && d.uploadedAt == request.time;
    }

    match /ai_events/{id}        { allow create: if validRecord(); allow read, update, delete: if false; }
    match /ai_sessions/{id}      { allow create: if validRecord(); allow read, update, delete: if false; }
    match /ai_db_mutations/{id}  { allow create: if validRecord(); allow read, update, delete: if false; }
    match /ai_db_reads/{id}      { allow create: if validRecord(); allow read, update, delete: if false; }

    // everything else stays closed
    match /{document=**} { allow read, write: if false; }
  }
}
